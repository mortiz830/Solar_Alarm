<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/fragment_listalarms_latitude"
            android:layout_width="203dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="test"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            app:layout_constraintLeft_toRightOf="@id/fragment_listalarms_latitude_txt"
            app:layout_constraintBottom_toTopOf="@id/fragment_listalarms_longitude"/>

        <TextView
            android:id="@+id/fragment_listalarms_longitude"
            android:layout_width="203dp"
            android:layout_height="wrap_content"
            android:text="test"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            app:layout_constraintTop_toBottomOf="@id/fragment_listalarms_latitude"
            app:layout_constraintLeft_toRightOf="@id/fragment_listalarms_longitude_txt"/>

        <TextView
            android:id="@+id/fragment_listalarms_latitude_txt"
            android:layout_width="208dp"
            android:layout_height="wrap_content"
            android:text="Latitude: "
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toLeftOf="@id/fragment_listalarms_latitude"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/fragment_listalarms_longitude_txt"
            android:layout_width="208dp"
            android:layout_height="wrap_content"
            android:text="Longitude: "
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            app:layout_constraintTop_toBottomOf="@+id/fragment_listalarms_latitude_txt"
            tools:layout_editor_absoluteX="0dp" />

        <Button
            android:id="@+id/add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toTopOf="@+id/fragment_listalarms_recylerView"
            app:layout_constraintTop_toBottomOf="@id/fragment_listalarms_longitude"
            tools:layout_editor_absoluteX="323dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fragment_listalarms_recylerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout_editor_absoluteX="16dp"
            app:layout_constraintTop_toBottomOf="@+id/add_button"
            >

        </androidx.recyclerview.widget.RecyclerView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>